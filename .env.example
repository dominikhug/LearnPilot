# Copy to .env for local development. On Railway, set these as service variables.

# Used by the LearnPilot app at runtime (not for Claude Code login)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Login password for the app, and the key that signs session cookies.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PASSWORD=
SESSION_SECRET=

# Set by docker-compose locally; Railway's PostgreSQL add-on provides it in production.
# DATABASE_URL=postgresql+psycopg://learnpilot:learnpilot@db:5432/learnpilot

MAX_DOCUMENT_TOKENS=50000
MAX_UPLOAD_MB=20
DAILY_TOKEN_LIMIT=2000000
