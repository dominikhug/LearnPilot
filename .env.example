# Copy to .env for local development. On Railway, set these as service variables.

# How the app calls Claude at runtime:
# - subscription (default): through Claude Code on your Claude subscription. Locally the
#   devcontainer's `claude` login is enough; elsewhere (Railway) run `claude setup-token`
#   and set CLAUDE_CODE_OAUTH_TOKEN. For personal use only (Anthropic's terms).
# - api_key: the Claude API with ANTHROPIC_API_KEY, billed as API credits.
LLM_AUTH=subscription
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Login password for the app, and the key that signs session cookies.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PASSWORD=
SESSION_SECRET=

# Set by docker-compose locally; Railway's PostgreSQL add-on provides it in production.
# DATABASE_URL=postgresql+psycopg://learnpilot:learnpilot@db:5432/learnpilot

MAX_DOCUMENT_TOKENS=50000
MAX_UPLOAD_MB=20
# Only for LLM_AUTH=api_key; the subscription has limits of its own.
DAILY_TOKEN_LIMIT=2000000
